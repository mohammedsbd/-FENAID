generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SUPER_ADMIN
  CASE_WORKER
  VIEWER
}

enum AccessLevel {
  FULL
  READ_ONLY
  NO_ACCESS
}

enum PermissionModule {
  ACCOUNTS
  MY_ACCOUNT
  AUDIT_LOGS
  SESSIONS
  PERMISSIONS
  PARENTS
  CHILDREN
  SERVICES
  FINANCE
  APPOINTMENTS
  DOCUMENTS
  DASHBOARD
  REPORTS
  DONATIONS
  VOLUNTEERS
  REFERRALS
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
}

enum FinancialBracket {
  LOW
  MEDIUM
  HIGH
}

enum ParentStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum MembershipStatus {
  PAID
  UNPAID
}

enum DisabilityType {
  PHYSICAL
  INTELLECTUAL
  MULTIPLE
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
}

enum SchoolEnrollmentStatus {
  ENROLLED
  NOT_ENROLLED
  GRADUATED
}

enum CommunicationAbility {
  VERBAL
  NON_VERBAL
  ASSISTED
}

enum ChildStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  INACTIVE
  DECEASED
}

enum ServiceTargetType {
  PARENT
  CHILD
}

enum ServiceFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  ONGOING
}

enum ServiceDeliveryMethod {
  ON_SITE
  HOME_VISIT
  REFERRAL
}

enum ServiceAssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FundAllocationStatus {
  ALLOCATED
  DISBURSED
  PARTIALLY_DISBURSED
}

enum DonorType {
  INDIVIDUAL
  ORGANIZATION
  ANONYMOUS
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  REGRESSED
}

enum GoalType {
  SHORT_TERM
  LONG_TERM
}

enum AppointmentType {
  THERAPY
  ASSESSMENT
  WORKSHOP
  FUND_DISBURSEMENT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  RESCHEDULED
}

enum NotificationType {
  PROGRESS_OVERDUE
  PROGRESS_NOTE_ADDED
  MILESTONE_UPDATED
  GOAL_UPDATED
  DOCUMENT_EXPIRY
  DOCUMENT_UPLOADED
  SERVICE_EXPIRY
  SERVICE_ASSIGNED
  FUND_REMINDER
  FUND_ALLOCATED
  FUND_STATUS_CHANGED
  DONATION_RECEIVED
  PARENT_REGISTERED
  PARENT_UPDATED
  CHILD_REGISTERED
  CHILD_UPDATED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_REMINDER
  ATTENDANCE_LOGGED
  ACCOUNT_SECURITY
  GENERAL
  REFERRAL_MADE
}

enum ReferralStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}

model Parent {
  id                 String           @id @default(cuid())
  idTag              String?          @unique
  fullName           String
  photoUrl           String?
  dateOfBirth        DateTime
  gender             String
  nationalId         String           @unique
  phone              String
  email              String?
  address            String
  city               String
  subcity            String
  woreda             String
  maritalStatus      MaritalStatus
  employmentStatus   EmploymentStatus
  financialBracket   FinancialBracket
  educationLevel     String
  numberOfDependents Int
  referralSource     String?
  membershipFee     Decimal?         @db.Decimal(12, 2)
  membershipStatus  MembershipStatus @default(UNPAID)
  status            ParentStatus
  internalNotes     String?          @db.Text
  assignedStaffId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  assignedStaff      Staff               @relation("ParentAssignedStaff", fields: [assignedStaffId], references: [id])
  children           Child[]
  serviceAssignments ServiceAssignment[]
  fundAllocations    FundAllocation[]
  appointments       Appointment[]
  attendanceRecords  AttendanceRecord[]
  documents          Document[]
  referrals          Referral[]

  @@index([assignedStaffId])
  @@index([status])
  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([assignedStaffId, status])
  @@index([financialBracket])
  @@index([city, subcity, status])
  @@index([assignedStaffId, createdAt])
  @@index([membershipStatus])
}

model Child {
  id                     String                 @id @default(cuid())
  idTag                  String?                @unique
  fullName               String
  photoUrl               String?
  dateOfBirth            DateTime
  gender                 String
  disabilityType         DisabilityType
  disabilityCategory     String
  severityLevel          SeverityLevel
  medicalHistory         String?                @db.Text
  medications            String?                @db.Text
  schoolEnrollmentStatus SchoolEnrollmentStatus
  communicationAbility   CommunicationAbility
  status                 ChildStatus
  internalNotes          String?                @db.Text
  parentId               String
  assignedStaffId        String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  parent              Parent              @relation(fields: [parentId], references: [id])
  assignedStaff       Staff               @relation("ChildAssignedStaff", fields: [assignedStaffId], references: [id])
  serviceAssignments  ServiceAssignment[]
  restrictedDonations Donation[]          @relation("DonationRestrictedToChild")
  progressNotes       ProgressNote[]
  milestones          Milestone[]
  goals               Goal[]
  appointments        Appointment[]
  attendanceRecords   AttendanceRecord[]
  documents           Document[]
  volunteerServices   VolunteerService[]
  referrals           Referral[]

  @@index([parentId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedStaffId, status])
  @@index([assignedStaffId, createdAt])
  @@index([disabilityType])
  @@index([severityLevel])
  @@index([dateOfBirth])
  @@index([parentId, status])
  @@index([disabilityType, severityLevel, status])
}

model Service {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  category    String
  targetType  ServiceTargetType
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  assignments         ServiceAssignment[]
  restrictedDonations Donation[]          @relation("DonationRestrictedToService")

  @@index([targetType])
  @@index([isActive])
  @@index([name])
}

model ServiceAssignment {
  id              String                  @id @default(cuid())
  serviceId       String
  targetType      ServiceTargetType
  parentId        String?
  childId         String?
  assignedStaffId String
  startDate       DateTime
  endDate         DateTime?
  frequency       ServiceFrequency
  deliveryMethod  ServiceDeliveryMethod
  status          ServiceAssignmentStatus
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  service       Service @relation(fields: [serviceId], references: [id])
  parent        Parent? @relation(fields: [parentId], references: [id])
  child         Child?  @relation(fields: [childId], references: [id])
  assignedStaff Staff   @relation("ServiceAssignmentAssignedStaff", fields: [assignedStaffId], references: [id])

  @@index([serviceId])
  @@index([parentId])
  @@index([parentId, status])
  @@index([childId])
  @@index([childId, status])
  @@index([assignedStaffId])
  @@index([status])
  @@index([assignedStaffId, status])
  @@index([status, endDate])
  @@index([createdAt])
  @@index([assignedStaffId, status, endDate])
}

model FundAllocation {
  id                 String               @id @default(cuid())
  parentId           String
  allocatedById      String
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("ETB")
  purpose            String
  allocationDate     DateTime
  status             FundAllocationStatus
  receiptUrl         String?
  parentAcknowledged Boolean              @default(false)
  acknowledgedAt     DateTime?
  notes              String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  parent      Parent @relation(fields: [parentId], references: [id])
  allocatedBy Staff  @relation("FundAllocationAllocatedBy", fields: [allocatedById], references: [id])

  @@index([parentId])
  @@index([parentId, status])
  @@index([allocatedById])
  @@index([status])
  @@index([status, createdAt])
  @@index([status, allocationDate])
  @@index([allocationDate])
}

model Donation {
  id                    String    @id @default(cuid())
  donorName             String
  donorContact          String?
  donorType             DonorType
  amount                Decimal   @db.Decimal(12, 2)
  currency              String    @default("ETB")
  donationDate          DateTime
  purpose               String?
  isRestricted          Boolean   @default(false)
  restrictedToChildId   String?
  restrictedToServiceId String?
  receivedById          String
  receiptNumber         String    @unique
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  restrictedToChild   Child?   @relation("DonationRestrictedToChild", fields: [restrictedToChildId], references: [id])
  restrictedToService Service? @relation("DonationRestrictedToService", fields: [restrictedToServiceId], references: [id])
  receivedBy          Staff    @relation("DonationReceivedBy", fields: [receivedById], references: [id])

  @@index([restrictedToChildId])
  @@index([restrictedToServiceId])
  @@index([receivedById])
  @@index([donationDate])
  @@index([donorType])
}

model ProgressNote {
  id        String   @id @default(cuid())
  childId   String
  staffId   String
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([childId])
  @@index([staffId])
  @@index([childId, createdAt])
}

model Milestone {
  id          String          @id @default(cuid())
  childId     String
  title       String
  description String?         @db.Text
  status      MilestoneStatus
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  child Child @relation(fields: [childId], references: [id])

  @@index([childId])
  @@index([status])
  @@index([childId, createdAt])
}

model Goal {
  id          String    @id @default(cuid())
  childId     String
  staffId     String
  title       String
  description String?   @db.Text
  type        GoalType
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([childId])
  @@index([staffId])
  @@index([type])
  @@index([childId, createdAt])
}

model Appointment {
  id              String            @id @default(cuid())
  title           String
  staffId         String
  childId         String?
  parentId        String?
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  type            AppointmentType
  isRecurring     Boolean           @default(false)
  recurrenceRule  String?
  status          AppointmentStatus
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  staff             Staff              @relation(fields: [staffId], references: [id])
  child             Child?             @relation(fields: [childId], references: [id])
  parent            Parent?            @relation(fields: [parentId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([staffId])
  @@index([childId])
  @@index([parentId])
  @@index([scheduledAt])
  @@index([status])
  @@index([staffId, scheduledAt])
  @@index([staffId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([type, scheduledAt])
  @@index([parentId, scheduledAt])
  @@index([childId, scheduledAt])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  appointmentId String
  parentId      String?
  childId       String?
  status        AttendanceStatus
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  parent      Parent?     @relation(fields: [parentId], references: [id])
  child       Child?      @relation(fields: [childId], references: [id])

  @@index([appointmentId])
  @@index([parentId])
  @@index([childId])
  @@index([status])
}

model Document {
  id           String    @id @default(cuid())
  name         String
  category     String
  fileUrl      String
  expiresAt    DateTime?
  uploadedById String
  parentId     String?
  childId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy Staff   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  parent     Parent? @relation(fields: [parentId], references: [id])
  child      Child?  @relation(fields: [childId], references: [id])

  @@index([uploadedById])
  @@index([parentId])
  @@index([parentId, category])
  @@index([childId])
  @@index([childId, category])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([category])
}

model Notification {
  id         String           @id @default(cuid())
  staffId    String
  message    String
  isRead     Boolean          @default(false)
  type       NotificationType
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([isRead])
  @@index([type])
  @@index([staffId, isRead, createdAt])
  @@index([staffId, isRead])
  @@index([staffId, type, entityType, entityId, isRead])
  @@index([entityType, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  action    String
  entity    String
  entityId  String
  changes   Json
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([entity, entityId])
  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@index([staffId, action, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  staffId    String
  tokenId    String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([tokenId])
  @@index([tokenId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([staffId, revokedAt])
  @@index([staffId, expiresAt, revokedAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  staffId      String
  passwordHash String
  createdAt    DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId, createdAt])
}

model RolePermission {
  id          String         @id @default(cuid())
  role        StaffRole
  module      PermissionModule
  accessLevel AccessLevel    @default(READ_ONLY)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([role, module])
  @@index([role])
  @@index([module])
}

model SavedQuery {
  id                String    @id @default(cuid())
  name              String
  description       String?
  createdById       String
  createdBy         Staff     @relation("SavedQueryCreator", fields: [createdById], references: [id])
  isOrgWide         Boolean   @default(false)
  filters           Json
  columns           Json
  dataSubject       String
  sortBy            String?
  sortDir           String?
  lastRunAt         DateTime?
  lastRunCount      Int?
  isScheduled       Boolean   @default(false)
  scheduleFrequency String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([createdById])
  @@index([isOrgWide])
  @@index([dataSubject])
}

model DataExportLog {
  id           String    @id @default(cuid())
  staffId      String
  staff        Staff     @relation("DataExportLogStaff", fields: [staffId], references: [id])
  savedQueryId String?
  queryFilters Json
  queryColumns Json
  dataSubject  String
  recordCount  Int
  exportFormat String
  anonymized   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([staffId])
  @@index([savedQueryId])
  @@index([createdAt])
}

model Staff {
  id                 String    @id @default(cuid())
  fullName           String
  email              String    @unique
  passwordHash       String
  phone              String?
  photoUrl           String?
  role               StaffRole
  isActive           Boolean   @default(true)
  canExportIdentified Boolean  @default(false)
  mustChangePassword Boolean   @default(true)
  deletedAt          DateTime?
  lastLoginAt        DateTime?
  passwordUpdatedAt  DateTime?
  notificationPreferences Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedParents          Parent[]            @relation("ParentAssignedStaff")
  assignedChildren         Child[]             @relation("ChildAssignedStaff")
  serviceAssignments       ServiceAssignment[] @relation("ServiceAssignmentAssignedStaff")
  allocatedFundAllocations FundAllocation[]    @relation("FundAllocationAllocatedBy")
  receivedDonations        Donation[]          @relation("DonationReceivedBy")
  progressNotes            ProgressNote[]
  goals                    Goal[]
  appointments             Appointment[]
  uploadedDocuments        Document[]          @relation("DocumentUploadedBy")
  notifications            Notification[]
  auditLogs                AuditLog[]
  sessions                 Session[]
  passwordHistories        PasswordHistory[]
  savedQueries             SavedQuery[]      @relation("SavedQueryCreator")
  dataExportLogs           DataExportLog[]   @relation("DataExportLogStaff")
  referrals                Referral[]

  @@index([role, isActive])
  @@index([createdAt])
}

model Volunteer {
  id           String             @id @default(cuid())
  fullName     String
  email        String             @unique
  phone        String
  status       String             @default("ACTIVE") // ACTIVE, INACTIVE
  serviceTypes String?            @db.Text
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  services     VolunteerService[]

  @@index([fullName])
  @@index([email])
}

model VolunteerService {
  id          String   @id @default(cuid())
  volunteerId String
  serviceType String   // Type of service (e.g. teaching, healthcare)
  childId     String?  // Nullable, if null it means "All Children" or general
  description String?  @db.Text
  serviceDate DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  child       Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([volunteerId])
  @@index([childId])
}

model Referral {
  id             String         @id @default(cuid())
  parentId       String?
  childId        String?
  referredTo     String
  referralReason String
  referralDate   DateTime
  status         ReferralStatus @default(PENDING)
  notes          String?        @db.Text
  outcome        String?        @db.Text
  followUpDate   DateTime?
  referredById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  parent  Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)
  staff   Staff   @relation(fields: [referredById], references: [id])

  @@index([parentId])
  @@index([childId])
  @@index([referredById])
  @@index([status])
  @@index([referralDate])
  @@index([referredById, status])
}
