generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SUPER_ADMIN
  CASE_WORKER
  VIEWER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
}

enum FinancialBracket {
  LOW
  MEDIUM
  HIGH
}

enum ParentStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum DisabilityType {
  PHYSICAL
  INTELLECTUAL
  MULTIPLE
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
}

enum SchoolEnrollmentStatus {
  ENROLLED
  NOT_ENROLLED
  GRADUATED
}

enum CommunicationAbility {
  VERBAL
  NON_VERBAL
  ASSISTED
}

enum ChildStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  INACTIVE
  DECEASED
}

enum ServiceTargetType {
  PARENT
  CHILD
}

enum ServiceFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  ONGOING
}

enum ServiceDeliveryMethod {
  ON_SITE
  HOME_VISIT
  REFERRAL
}

enum ServiceAssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FundAllocationStatus {
  ALLOCATED
  DISBURSED
  PARTIALLY_DISBURSED
}

enum DonorType {
  INDIVIDUAL
  ORGANIZATION
  ANONYMOUS
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  REGRESSED
}

enum GoalType {
  SHORT_TERM
  LONG_TERM
}

enum AppointmentType {
  THERAPY
  ASSESSMENT
  WORKSHOP
  FUND_DISBURSEMENT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  RESCHEDULED
}

enum NotificationType {
  PROGRESS_OVERDUE
  DOCUMENT_EXPIRY
  SERVICE_EXPIRY
  FUND_REMINDER
  GENERAL
}

model Staff {
  id                 String    @id @default(cuid())
  fullName           String
  email              String    @unique
  passwordHash       String
  role               StaffRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedParents          Parent[]            @relation("ParentAssignedStaff")
  assignedChildren         Child[]             @relation("ChildAssignedStaff")
  serviceAssignments       ServiceAssignment[] @relation("ServiceAssignmentAssignedStaff")
  allocatedFundAllocations FundAllocation[]    @relation("FundAllocationAllocatedBy")
  receivedDonations        Donation[]          @relation("DonationReceivedBy")
  progressNotes            ProgressNote[]
  goals                    Goal[]
  appointments             Appointment[]
  uploadedDocuments        Document[]          @relation("DocumentUploadedBy")
  notifications            Notification[]
  auditLogs                AuditLog[]
}

model Parent {
  id                 String           @id @default(cuid())
  fullName           String
  photoUrl           String?
  dateOfBirth        DateTime
  gender             String
  nationalId         String           @unique
  phone              String
  email              String?
  address            String
  city               String
  subcity            String
  woreda             String
  maritalStatus      MaritalStatus
  employmentStatus   EmploymentStatus
  financialBracket   FinancialBracket
  educationLevel     String
  numberOfDependents Int
  referralSource     String
  status             ParentStatus
  internalNotes      String?          @db.Text
  assignedStaffId    String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  assignedStaff      Staff               @relation("ParentAssignedStaff", fields: [assignedStaffId], references: [id])
  children           Child[]
  serviceAssignments ServiceAssignment[]
  fundAllocations    FundAllocation[]
  appointments       Appointment[]
  attendanceRecords  AttendanceRecord[]
  documents          Document[]

  @@index([assignedStaffId])
  @@index([status])
}

model Child {
  id                     String                 @id @default(cuid())
  fullName               String
  photoUrl               String?
  dateOfBirth            DateTime
  gender                 String
  disabilityType         DisabilityType
  disabilityCategory     String
  severityLevel          SeverityLevel
  medicalHistory         String?                @db.Text
  medications            String?                @db.Text
  schoolEnrollmentStatus SchoolEnrollmentStatus
  communicationAbility   CommunicationAbility
  status                 ChildStatus
  internalNotes          String?                @db.Text
  parentId               String
  assignedStaffId        String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  parent              Parent              @relation(fields: [parentId], references: [id])
  assignedStaff       Staff               @relation("ChildAssignedStaff", fields: [assignedStaffId], references: [id])
  serviceAssignments  ServiceAssignment[]
  restrictedDonations Donation[]          @relation("DonationRestrictedToChild")
  progressNotes       ProgressNote[]
  milestones          Milestone[]
  goals               Goal[]
  appointments        Appointment[]
  attendanceRecords   AttendanceRecord[]
  documents           Document[]

  @@index([parentId])
  @@index([assignedStaffId])
  @@index([status])
}

model Service {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  category    String
  targetType  ServiceTargetType
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  assignments         ServiceAssignment[]
  restrictedDonations Donation[]          @relation("DonationRestrictedToService")

  @@index([targetType])
  @@index([isActive])
}

model ServiceAssignment {
  id              String                  @id @default(cuid())
  serviceId       String
  targetType      ServiceTargetType
  parentId        String?
  childId         String?
  assignedStaffId String
  startDate       DateTime
  endDate         DateTime?
  frequency       ServiceFrequency
  deliveryMethod  ServiceDeliveryMethod
  status          ServiceAssignmentStatus
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  service       Service @relation(fields: [serviceId], references: [id])
  parent        Parent? @relation(fields: [parentId], references: [id])
  child         Child?  @relation(fields: [childId], references: [id])
  assignedStaff Staff   @relation("ServiceAssignmentAssignedStaff", fields: [assignedStaffId], references: [id])

  @@index([serviceId])
  @@index([parentId])
  @@index([childId])
  @@index([assignedStaffId])
  @@index([status])
}

model FundAllocation {
  id                 String               @id @default(cuid())
  parentId           String
  allocatedById      String
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("ETB")
  purpose            String
  allocationDate     DateTime
  status             FundAllocationStatus
  receiptUrl         String?
  parentAcknowledged Boolean              @default(false)
  acknowledgedAt     DateTime?
  notes              String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  parent      Parent @relation(fields: [parentId], references: [id])
  allocatedBy Staff  @relation("FundAllocationAllocatedBy", fields: [allocatedById], references: [id])

  @@index([parentId])
  @@index([allocatedById])
  @@index([status])
}

model Donation {
  id                    String    @id @default(cuid())
  donorName             String
  donorContact          String?
  donorType             DonorType
  amount                Decimal   @db.Decimal(12, 2)
  currency              String    @default("ETB")
  donationDate          DateTime
  purpose               String?
  isRestricted          Boolean   @default(false)
  restrictedToChildId   String?
  restrictedToServiceId String?
  receivedById          String
  receiptNumber         String    @unique
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  restrictedToChild   Child?   @relation("DonationRestrictedToChild", fields: [restrictedToChildId], references: [id])
  restrictedToService Service? @relation("DonationRestrictedToService", fields: [restrictedToServiceId], references: [id])
  receivedBy          Staff    @relation("DonationReceivedBy", fields: [receivedById], references: [id])

  @@index([restrictedToChildId])
  @@index([restrictedToServiceId])
  @@index([receivedById])
}

model ProgressNote {
  id        String   @id @default(cuid())
  childId   String
  staffId   String
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([childId])
  @@index([staffId])
}

model Milestone {
  id          String          @id @default(cuid())
  childId     String
  title       String
  description String?         @db.Text
  status      MilestoneStatus
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  child Child @relation(fields: [childId], references: [id])

  @@index([childId])
  @@index([status])
}

model Goal {
  id          String    @id @default(cuid())
  childId     String
  staffId     String
  title       String
  description String?   @db.Text
  type        GoalType
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])

  @@index([childId])
  @@index([staffId])
  @@index([type])
}

model Appointment {
  id              String            @id @default(cuid())
  title           String
  staffId         String
  childId         String?
  parentId        String?
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  type            AppointmentType
  isRecurring     Boolean           @default(false)
  recurrenceRule  String?
  status          AppointmentStatus
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  staff             Staff              @relation(fields: [staffId], references: [id])
  child             Child?             @relation(fields: [childId], references: [id])
  parent            Parent?            @relation(fields: [parentId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([staffId])
  @@index([childId])
  @@index([parentId])
  @@index([scheduledAt])
  @@index([status])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  appointmentId String
  parentId      String?
  childId       String?
  status        AttendanceStatus
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  parent      Parent?     @relation(fields: [parentId], references: [id])
  child       Child?      @relation(fields: [childId], references: [id])

  @@index([appointmentId])
  @@index([parentId])
  @@index([childId])
  @@index([status])
}

model Document {
  id           String    @id @default(cuid())
  name         String
  category     String
  fileUrl      String
  expiresAt    DateTime?
  uploadedById String
  parentId     String?
  childId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy Staff   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  parent     Parent? @relation(fields: [parentId], references: [id])
  child      Child?  @relation(fields: [childId], references: [id])

  @@index([uploadedById])
  @@index([parentId])
  @@index([childId])
  @@index([expiresAt])
}

model Notification {
  id         String           @id @default(cuid())
  staffId    String
  message    String
  isRead     Boolean          @default(false)
  type       NotificationType
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([isRead])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  action    String
  entity    String
  entityId  String
  changes   Json
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([entity, entityId])
  @@index([createdAt])
}
