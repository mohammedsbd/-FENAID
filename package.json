{
  "name": "fikir",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "cross-env PORT=3101 NEXT_PUBLIC_API_URL=http://localhost:3101 pnpm --parallel --filter @fikir/backend --filter @fikir/frontend dev",
    "dev:backend": "cross-env PORT=3101 pnpm --filter @fikir/backend dev",
    "dev:frontend": "cross-env NEXT_PUBLIC_API_URL=http://localhost:3101 pnpm --filter @fikir/frontend dev",
    "build": "pnpm --filter @fikir/types build && pnpm --filter @fikir/backend exec prisma generate && pnpm --filter @fikir/backend build && pnpm --filter @fikir/frontend build",
    "start": "pnpm --parallel --filter @fikir/backend --filter @fikir/frontend start",
    "start:backend": "pnpm --filter @fikir/backend start",
    "start:frontend": "pnpm --filter @fikir/frontend start",
    "db:migrate": "pnpm --filter @fikir/backend exec prisma migrate deploy",
    "db:push": "pnpm --filter @fikir/backend exec prisma db push",
    "db:seed": "pnpm --filter @fikir/backend exec prisma db seed",
    "setup": "pnpm install && pnpm build && pnpm db:push && pnpm db:seed",
    "docker:up": "docker compose up -d db",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "pnpm db:migrate",
    "docker:seed": "pnpm db:seed",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.30",
    "globals": "^17.6.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
